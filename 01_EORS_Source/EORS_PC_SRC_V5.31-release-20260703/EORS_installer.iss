; EORS Installer Script
; Generated by Inno Setup
; 请将此文件保存为 UTF-8 with BOM 编码

#define MyAppVersion "5.2"

[Setup]
AppName=EORS
AppVersion={#MyAppVersion}
AppPublisher=Your Company
AppPublisherURL=https://www.example.com/
AppSupportURL=https://www.example.com/support
AppUpdatesURL=https://www.example.com/updates
DefaultDirName={pf}\EORS
DefaultGroupName=EORS
OutputBaseFilename=EORS_Setup_{#MyAppVersion}
; 确保版本号与Readme.md中的最新版本一致
; 每次更新版本时，只需修改上面的AppVersion值即可
Compression=lzma
SolidCompression=yes
ShowLanguageDialog=no
LanguageDetectionMethod=none

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "附加任务:"; Flags: unchecked

[Files]
Source: "dist\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs
Source: "P02_Resource\images\logo.png"; DestDir: "{app}\images"; Flags: ignoreversion

[Icons]
Name: "{group}\EORS"; Filename: "{app}\EORS.exe"
Name: "{commondesktop}\EORS"; Filename: "{app}\EORS.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\EORS.exe"; Description: "运行 EORS"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
Type: filesandordirs; Name: "{app}"

[Messages]
WelcomeLabel2=欢迎使用 EORS 安装程序 v%1.%2
FinishedHeading=安装完成
FinishedLabel=EORS 安装已完成。