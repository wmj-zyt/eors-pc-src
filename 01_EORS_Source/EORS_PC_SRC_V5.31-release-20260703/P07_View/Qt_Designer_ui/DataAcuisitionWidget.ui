        }
QComboBox:on {
         border: 1px solid #63acfb;
        }

QComboBox::drop-down {
       width: 22px;
       border-left: 1px solid lightgray;
       border-top-right-radius: 8px;
       border-bottom-right-radius: 8px;
        }
        
QComboBox::drop-down:on {
            border-left: 1px solid #63acfb;
        }

