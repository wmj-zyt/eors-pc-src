                 <item>
                  <widget class="QSlider" name="videoSlider">
                   <property name="styleSheet">
                    <string notr="true">/* 水平滑块基础样式 */
QSlider::horizontal {
    height: 10px;
    margin: 0;
}

/* 水平滑块轨道 */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #e1d9fe;
    border-radius: 2px;
}

/* 水平滑块已填充部分 */
QSlider::sub-page:horizontal {
    height: 4px;
    background-color: #9265F4;
    border-radius: 2px;
}

/* 水平滑块未填充部分 */
QSlider::add-page:horizontal {
    height: 4px;
    background-color: #e1d9fe;
    border-radius: 2px;
}

/* 水平滑块手柄 */
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 2px solid #9265F4;
    border-radius: 8px;
    margin: -6px 0;
    transition: all 0.2s ease;
}

/* 水平滑块手柄悬停状态 */
QSlider::handle:horizontal:hover {
    background-color: #f0e6ff;
    border-color: #7942F0;
    transform: scale(1.1);
}

/* 水平滑块手柄按下状态 */
QSlider::handle:horizontal:pressed {
    background-color: #9265F4;
    border-color: #9265F4;
    transform: scale(1.2);
}

/* 垂直滑块基础样式（如果需要） */
QSlider::vertical {
    width: 10px;
    margin: 0;
}

/* 垂直滑块轨道 */
QSlider::groove:vertical {
    width: 4px;
    background-color: #e1d9fe;
    border-radius: 2px;
}

/* 垂直滑块已填充部分 */
QSlider::sub-page:vertical {
    width: 4px;
    background-color: #9265F4;
    border-radius: 2px;
}

/* 垂直滑块未填充部分 */
QSlider::add-page:vertical {
    width: 4px;
    background-color: #e1d9fe;
    border-radius: 2px;
}

/* 垂直滑块手柄 */
QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 2px solid #9265F4;
    border-radius: 8px;
    margin: 0 -6px;
    transition: all 0.2s ease;
}

/* 垂直滑块手柄悬停状态 */
QSlider::handle:vertical:hover {
    background-color: #f0e6ff;
    border-color: #7942F0;
    transform: scale(1.1);
}

/* 垂直滑块手柄按下状态 */
QSlider::handle:vertical:pressed {
    background-color: #9265F4;
    border-color: #9265F4;
    transform: scale(1.2);
}</string>
                   </property>
                   <property name="orientation">
                    <enum>Qt::Horizontal</enum>
                   </property>
                  </widget>
